page { background: #f8f8f8; }

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── header ── */
.header {
  flex-shrink: 0;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
  padding: 24rpx 28rpx 0;
}
.header-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.week-title { font-size: 36rpx; font-weight: 600; color: #111; }
.week-date  { font-size: 22rpx; color: #999; }
.today-badge {
  font-size: 22rpx; color: #888;
  background: #f2f2f2; border-radius: 99rpx;
  padding: 6rpx 20rpx;
}
.week-strip { white-space: nowrap; padding-bottom: 20rpx; }
.week-btns  { display: flex; gap: 10rpx; }
.week-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  font-size: 22rpx; font-weight: 500;
  border: 1rpx solid #e0e0e0; color: #555; background: transparent;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.week-btn.active { background: #111; color: #fff; border-color: #111; }

/* ── allweek bar ── */
.allweek-bar {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  padding: 12rpx 24rpx;
  background: #fff; border-bottom: 1rpx solid #e8e8e8;
  align-items: center; flex-shrink: 0;
}
.allweek-label { font-size: 20rpx; color: #aaa; }
.aw-chip {
  font-size: 20rpx; padding: 4rpx 16rpx;
  border-radius: 99rpx; background: #f0f0f0; color: #555;
}

/* ── timetable ── */
.tt-scroll { flex: 1; }

.tt-grid {
  display: grid;
  grid-template-columns: 104rpx repeat(7, 160rpx);
  grid-template-rows: 96rpx repeat(13, 112rpx);
  width: 1224rpx; /* 104 + 7×160 */
}

.corner {
  grid-column: 1; grid-row: 1;
  background: #f8f8f8;
  border-right: 1rpx solid #e8e8e8;
  border-bottom: 1rpx solid #e8e8e8;
}

/* day headers */
.day-hd {
  grid-row: 1;
  background: #fff;
  border-right: 1rpx solid #e8e8e8;
  border-bottom: 1rpx solid #e8e8e8;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 4rpx;
}
.today-hd { background: #111; }
.day-name { font-size: 22rpx; font-weight: 600; color: #111; }
.day-date { font-size: 20rpx; color: #bbb; }
.txt-white { color: #fff; }
.txt-white-dim { color: rgba(255,255,255,0.6); }

/* time cells */
.time-cell {
  background: #f8f8f8;
  border-right: 1rpx solid #e8e8e8;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.sec-label { font-size: 16rpx; color: #ccc; margin-bottom: 4rpx; }
.p-num  { font-size: 20rpx; font-weight: 500; color: #bbb; }
.p-time { font-size: 16rpx; color: #d0d0d0; }
.p-sep  { font-size: 16rpx; color: #e0e0e0; }

/* background cells */
.bg-cell {
  border-right: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}
.today-col { background: #f0f5ff; }
.sec-break { border-top: 4rpx solid #e0e0e0; }

/* course blocks */
.course-blk {
  margin: 4rpx;
  border-radius: 16rpx;
  padding: 10rpx 12rpx;
  overflow: hidden;
  display: flex; flex-direction: column;
  border-left: 6rpx solid transparent;
}
.c-name {
  font-size: 22rpx; font-weight: 600;
  line-height: 1.3; color: inherit;
  overflow: hidden;
}
.c-room {
  font-size: 18rpx; opacity: 0.65;
  margin-top: 4rpx; color: inherit; overflow: hidden;
}
.c-parity {
  font-size: 16rpx; opacity: 0.55;
  margin-top: auto; color: inherit;
}
