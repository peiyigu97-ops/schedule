<view class="page">

  <!-- 顶部 header -->
  <view class="header" id="hd">
    <view class="header-top">
      <view>
        <text class="week-title">第{{week}}周</text>
        <text class="week-date"> {{weekDate}}</text>
      </view>
      <text class="today-badge">{{todayBadge}}</text>
    </view>
    <scroll-view scroll-x class="week-strip">
      <view class="week-btns">
        <view
          wx:for="{{weekNums}}" wx:key="*this"
          class="week-btn {{item === week ? 'active' : ''}}"
          bindtap="onWeekTap" data-week="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 全周课程条 -->
  <view class="allweek-bar" wx:if="{{allWeekCourses.length}}">
    <text class="allweek-label">全周</text>
    <view wx:for="{{allWeekCourses}}" wx:key="name" class="aw-chip">
      <text>{{item.name}}{{item.classroom ? ' · ' + item.classroom : ''}}</text>
    </view>
  </view>

  <!-- 课程表格 -->
  <scroll-view scroll-x scroll-y class="tt-scroll">
    <view class="tt-grid">

      <!-- 角落 -->
      <view class="corner"></view>

      <!-- 星期标题 -->
      <view
        wx:for="{{dayHeaders}}" wx:key="col"
        class="day-hd {{item.isToday ? 'today-hd' : ''}}"
        style="grid-column:{{item.col}};grid-row:1;"
      >
        <text class="day-name {{item.isToday ? 'txt-white' : ''}}">{{item.name}}</text>
        <text class="day-date {{item.isToday ? 'txt-white-dim' : ''}}">{{item.date}}</text>
      </view>

      <!-- 时间列 -->
      <view
        wx:for="{{timeCells}}" wx:key="idx"
        class="time-cell {{item.isBreak ? 'sec-break' : ''}}"
        style="{{item.style}}"
      >
        <text class="sec-label" wx:if="{{item.sLabel}}">{{item.sLabel}}</text>
        <text class="p-num">{{item.idx}}</text>
        <text class="p-time">{{item.t}}</text>
        <text class="p-sep">–</text>
        <text class="p-time">{{item.e}}</text>
      </view>

      <!-- 课程块 -->
      <view
        wx:for="{{courseBlocks}}" wx:key="index"
        class="course-blk"
        style="{{item.style}}"
      >
        <text class="c-name">{{item.name}}</text>
        <text class="c-room" wx:if="{{item.classroom}}">{{item.classroom}}</text>
        <text class="c-parity" wx:if="{{item.parity}}">{{item.parity}}</text>
      </view>

    </view>
  </scroll-view>

</view>
