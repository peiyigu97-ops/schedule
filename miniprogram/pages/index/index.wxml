<view class="page">

  <view class="header" id="hd">
    <view class="header-top">
      <view>
        <text class="week-title">第{{week}}周</text>
        <text class="week-date"> {{weekDate}}</text>
      </view>
      <text class="today-badge">{{todayBadge}}</text>
    </view>
    <scroll-view scroll-x class="week-strip">
      <view class="week-btns">
        <view
          wx:for="{{weekNums}}" wx:key="*this"
          class="week-btn {{item === week ? 'active' : ''}}"
          bindtap="onWeekTap" data-week="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="allweek-bar" wx:if="{{allWeekCourses.length}}">
    <text class="allweek-label">全周</text>
    <view wx:for="{{allWeekCourses}}" wx:key="name" class="aw-chip">
      <text>{{item.name}}{{item.classroom ? ' · ' + item.classroom : ''}}</text>
    </view>
  </view>

  <scroll-view scroll-y class="tt-scroll">
    <view class="tt-grid">

      <view class="corner"></view>

      <view
        wx:for="{{dayHeaders}}" wx:key="col"
        class="day-hd {{item.isToday ? 'today-hd' : ''}}"
        style="grid-column:{{item.col}};grid-row:1;"
      >
        <text class="day-name {{item.isToday ? 'txt-white' : ''}}">{{item.name}}</text>
        <text class="day-date {{item.isToday ? 'txt-white-dim' : ''}}">{{item.date}}</text>
      </view>

      <view class="time-cell" style="grid-column:1;grid-row:2;"><text class="sec-label">上午</text><text class="p-num">1</text><text class="p-time">08:00–08:45</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:3;"><text class="p-num">2</text><text class="p-time">08:50–09:35</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:4;"><text class="p-num">3</text><text class="p-time">09:40–10:25</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:5;"><text class="p-num">4</text><text class="p-time">10:40–11:25</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:6;"><text class="p-num">5</text><text class="p-time">11:30–12:15</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:7;"><text class="sec-label">下午</text><text class="p-num">6</text><text class="p-time">14:00–14:45</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:8;"><text class="p-num">7</text><text class="p-time">14:50–15:35</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:9;"><text class="p-num">8</text><text class="p-time">15:50–16:35</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:10;"><text class="p-num">9</text><text class="p-time">16:40–17:25</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:11;"><text class="p-num">10</text><text class="p-time">17:30–18:15</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:12;"><text class="sec-label">晚上</text><text class="p-num">11</text><text class="p-time">19:00–19:45</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:13;"><text class="p-num">12</text><text class="p-time">19:50–20:35</text></view>
      <view class="time-cell" style="grid-column:1;grid-row:14;"><text class="p-num">13</text><text class="p-time">20:40–21:25</text></view>

      <view
        wx:for="{{courseBlocks}}" wx:key="index"
        class="course-blk"
        style="{{item.style}}"
      >
        <text class="c-name">{{item.name}}</text>
        <text class="c-room" wx:if="{{item.classroom}}">{{item.classroom}}</text>
        <text class="c-parity" wx:if="{{item.parity}}">{{item.parity}}</text>
      </view>

    </view>
  </scroll-view>

</view>
